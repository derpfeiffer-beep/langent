<Window x:Class="Langent.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Langent – Einstellungen"
        Width="600" Height="600" MinWidth="520" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#33C08000" CornerRadius="3" Padding="8" Margin="0,0,0,8"
                Visibility="{Binding KeyMissingHint, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Kein API-Schlüssel hinterlegt. Bitte im Reiter Claude eintragen."
                       TextWrapping="Wrap" />
        </Border>

        <TabControl Grid.Row="1" Background="{DynamicResource Panel}">
            <!-- Allgemein -->
            <TabItem Header="Allgemein">
                <StackPanel Margin="12">
                    <TextBlock Text="Zielsprache" Margin="0,4,0,2" />
                    <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedTarget}"
                              DisplayMemberPath="GermanName" Width="220" HorizontalAlignment="Left" />
                    <TextBlock Text="Zweitsprache" Margin="0,10,0,2" />
                    <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedSecondary}"
                              DisplayMemberPath="GermanName" Width="220" HorizontalAlignment="Left" />
                    <TextBlock Text="Tonalität" Margin="0,10,0,2" />
                    <ComboBox ItemsSource="{Binding ToneOptions}" SelectedItem="{Binding SelectedTone}"
                              DisplayMemberPath="Label" Width="220" HorizontalAlignment="Left" />
                    <CheckBox Content="Autostart" IsChecked="{Binding Autostart}" Margin="0,12,0,0" />
                    <CheckBox Content="Strg+C+C aktiv" IsChecked="{Binding DoubleCopyEnabled}" Margin="0,8,0,0" />
                    <TextBlock Text="Zeitfenster (ms)" Margin="0,10,0,2" />
                    <TextBox Text="{Binding WindowMs}" Width="100" HorizontalAlignment="Left" />
                </StackPanel>
            </TabItem>

            <!-- Claude -->
            <TabItem Header="Claude">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock Text="API-Schlüssel" Margin="0,4,0,2" />
                        <StackPanel Orientation="Horizontal">
                            <PasswordBox x:Name="KeyBox" Width="300" />
                            <Button Content="Verbindung testen" Margin="8,0,0,0" Padding="8,2"
                                    Command="{Binding TestConnectionCommand}" IsEnabled="{Binding TestNotInProgress}" />
                        </StackPanel>
                        <TextBlock Margin="0,4,0,0">
                            <Run Text="Status: " />
                            <Run Text="{Binding KeyStatus}" />
                        </TextBlock>
                        <TextBlock Text="{Binding TestStatus}" Foreground="{DynamicResource Muted}" Margin="0,2,0,0" TextWrapping="Wrap" />

                        <TextBlock Text="Modell" Margin="0,10,0,2" />
                        <TextBox Text="{Binding Model}" Width="260" HorizontalAlignment="Left" />
                        <TextBlock Text="Qualitätsmodell" Margin="0,10,0,2" />
                        <TextBox Text="{Binding QualityModel}" Width="260" HorizontalAlignment="Left" />

                        <TextBlock Text="Preise (USD je Mio. Token)" Margin="0,10,0,2" />
                        <DataGrid ItemsSource="{Binding Prices}" AutoGenerateColumns="False"
                                  CanUserAddRows="False" Height="90" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Modell" Binding="{Binding Model}" Width="*" />
                                <DataGridTextColumn Header="Input" Binding="{Binding InputPerMTokUsd}" Width="90" />
                                <DataGridTextColumn Header="Output" Binding="{Binding OutputPerMTokUsd}" Width="90" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="Eigene Anweisungen" Margin="0,10,0,2" />
                        <TextBox Text="{Binding CustomInstructions}" AcceptsReturn="True" TextWrapping="Wrap"
                                 Height="60" VerticalScrollBarVisibility="Auto" />

                        <TextBlock Text="Glossar" Margin="0,10,0,2" />
                        <DataGrid ItemsSource="{Binding Glossary}" AutoGenerateColumns="False"
                                  CanUserAddRows="True" Height="120" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Quelle" Binding="{Binding Source}" Width="*" />
                                <DataGridTextColumn Header="Ziel" Binding="{Binding Target}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Verhalten -->
            <TabItem Header="Verhalten">
                <StackPanel Margin="12">
                    <CheckBox Content="Zwischenablage wiederherstellen" IsChecked="{Binding RestoreClipboard}" />
                    <TextBlock Text="Ausgeschlossene Programme (ein Prozess je Zeile)" Margin="0,12,0,2" />
                    <TextBox Text="{Binding ExcludedProcessesText}" AcceptsReturn="True" TextWrapping="Wrap"
                             Height="120" VerticalScrollBarVisibility="Auto" />
                    <TextBlock Text="Maximale Zeichenzahl" Margin="0,10,0,2" />
                    <TextBox Text="{Binding MaxInputChars}" Width="120" HorizontalAlignment="Left" />
                    <TextBlock Text="Monatsbudget (USD, leer = keins)" Margin="0,10,0,2" />
                    <TextBox Text="{Binding MonthlyBudget}" Width="120" HorizontalAlignment="Left" />
                </StackPanel>
            </TabItem>

            <!-- Verbrauch -->
            <TabItem Header="Verbrauch">
                <StackPanel Margin="12">
                    <TextBlock Margin="0,4"><Run Text="Heute: " /><Run Text="{Binding TodayText}" /></TextBlock>
                    <TextBlock Margin="0,4"><Run Text="Monat: " /><Run Text="{Binding MonthText}" /></TextBlock>
                    <TextBlock Margin="0,4"><Run Text="Vormonat: " /><Run Text="{Binding PreviousMonthText}" /></TextBlock>
                    <Button Content="usage.csv öffnen" Margin="0,12,0,0" Padding="10,4"
                            HorizontalAlignment="Left" Command="{Binding OpenUsageCsvCommand}" />
                </StackPanel>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Speichern" IsDefault="True" Padding="14,4" Margin="0,0,6,0"
                    Command="{Binding SaveCommand}" />
            <Button Content="Abbrechen" IsCancel="True" Padding="14,4" Command="{Binding CancelDialogCommand}" />
        </StackPanel>
    </Grid>
</Window>
