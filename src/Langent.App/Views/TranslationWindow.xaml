<Window x:Class="Langent.App.Views.TranslationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Langent"
        WindowStyle="None"
        ResizeMode="CanResize"
        Topmost="True"
        ShowInTaskbar="False"
        MinWidth="420" MinHeight="300"
        Background="{DynamicResource Bg}"
        Foreground="{DynamicResource Fg}"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="Return" Command="{Binding ReplaceCommand}" />
        <KeyBinding Modifiers="Control+Shift" Key="C" Command="{Binding CopyCommand}" />
        <KeyBinding Modifiers="Control" Key="R" Command="{Binding RetranslateCommand}" />
    </Window.InputBindings>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- title bar -->
            <RowDefinition Height="Auto" />
            <!-- header -->
            <RowDefinition Height="*" />
            <!-- original | translation (side by side) -->
            <RowDefinition Height="Auto" />
            <!-- banners -->
            <RowDefinition Height="Auto" />
            <!-- buttons -->
            <RowDefinition Height="Auto" />
            <!-- footer -->
        </Grid.RowDefinitions>

        <!-- Title bar (draggable) -->
        <Border x:Name="TitleBar" Grid.Row="0" Background="{DynamicResource Panel}" Padding="10,6">
            <Grid>
                <TextBlock Text="Langent" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Content="✕" HorizontalAlignment="Right" Width="26" Height="22"
                        Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Muted}"
                        Click="Close_Click" />
            </Grid>
        </Border>

        <!-- Header controls -->
        <WrapPanel Grid.Row="1" Margin="10,8" Orientation="Horizontal">
            <ComboBox x:Name="SourceCombo" Width="150" Margin="0,0,6,0"
                      ItemsSource="{Binding SourceOptions}" SelectedItem="{Binding SelectedSource}"
                      DisplayMemberPath="Display" />
            <TextBlock Text="→" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox x:Name="TargetCombo" Width="130" Margin="0,0,6,0"
                      ItemsSource="{Binding TargetOptions}" SelectedItem="{Binding SelectedTarget}"
                      DisplayMemberPath="GermanName" />
            <Button Content="Tauschen" Margin="0,0,10,0" Padding="8,2" Command="{Binding SwapCommand}" />
            <ComboBox Width="90" Margin="0,0,10,0"
                      ItemsSource="{Binding ToneOptions}" SelectedItem="{Binding SelectedTone}"
                      DisplayMemberPath="Label" />
            <CheckBox Content="Hohe Qualität" VerticalAlignment="Center" IsChecked="{Binding HighQuality}" />
        </WrapPanel>

        <!-- Original (left) | Übersetzung (right) -->
        <Grid Grid.Row="2" Margin="10,0,10,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Original -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="Original" Foreground="{DynamicResource Muted}"
                           Margin="2,0,0,2" />
                <TextBox Text="{Binding OriginalText, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         Background="{DynamicResource Panel}" Foreground="{DynamicResource Fg}"
                         BorderBrush="{DynamicResource Border}" BorderThickness="1" Padding="6">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="IsReadOnly" Value="True" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding OriginalEditable}" Value="True">
                                    <Setter Property="IsReadOnly" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                          Background="Transparent" />

            <!-- Übersetzung -->
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="Übersetzung" Foreground="{DynamicResource Muted}"
                           Margin="2,0,0,2" />
                <TextBox x:Name="TranslationBox"
                         Text="{Binding TranslationText, UpdateSourceTrigger=PropertyChanged}"
                         IsReadOnly="{Binding IsStreaming}"
                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         Background="{DynamicResource Panel}" Foreground="{DynamicResource Fg}"
                         BorderBrush="{DynamicResource Border}" BorderThickness="1" Padding="6" />
            </DockPanel>
        </Grid>

        <!-- Banners -->
        <StackPanel Grid.Row="3" Margin="10,0,10,8">
            <Border Background="#33D23030" CornerRadius="3" Padding="8"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Fg}"
                               VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="320" />
                    <Button Content="Erneut versuchen" Margin="10,0,0,0" Padding="8,2"
                            Command="{Binding RetryCommand}" />
                    <Button Content="Einstellungen öffnen" Margin="6,0,0,0" Padding="8,2"
                            Command="{Binding OpenSettingsCommand}"
                            Visibility="{Binding ShowMissingKeyAction, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>
            <Border Background="#33C08000" CornerRadius="3" Padding="8"
                    Visibility="{Binding NeedsLengthConfirmation, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding ErrorMessage}" VerticalAlignment="Center" />
                    <Button Content="Trotzdem übersetzen" Margin="10,0,0,0" Padding="8,2"
                            Command="{Binding TranslateAnywayCommand}" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10,0,10,8">
            <Button Content="Ersetzen" IsDefault="True" Padding="12,4" Margin="0,0,6,0"
                    Command="{Binding ReplaceCommand}" />
            <Button Content="Kopieren" Padding="12,4" Margin="0,0,6,0" Command="{Binding CopyCommand}" />
            <Button Content="Neu übersetzen" Padding="12,4" Command="{Binding RetranslateCommand}" />
        </StackPanel>

        <!-- Footer -->
        <Border Grid.Row="5" Background="{DynamicResource Panel}" Padding="10,5">
            <TextBlock Text="{Binding FooterText}" Foreground="{DynamicResource Muted}"
                       TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</Window>
